# Copy this file to .dev.vars and fill in real values before running locally.
# .dev.vars is gitignored — never commit it.
#
# Usage:
#   cp .dev.vars.example .dev.vars
#   # then edit .dev.vars with your real secrets

# ─── Required ────────────────────────────────────────────────────────────────

# JWT signing secret — minimum 32 characters, any random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Brevo API key — transactional email (interview notifications, reminders).
# Sends to any address from a single verified sender; no domain needed.
# Sign up free at https://www.brevo.com → Senders → verify the address in
# BREVO_FROM_EMAIL (wrangler.toml), then SMTP & API → API Keys → Generate.
# Free tier: 300 emails/day. Used when EMAIL_PROVIDER or EMAIL_FALLBACK_PROVIDER is "brevo".
# Brevo refuses API calls from IP addresses it has not seen ("unrecognised IP
# address", 401). Workers have no fixed IPs, so turn that off once:
# https://app.brevo.com/security/authorised_ips → Deactivate blocking.
# Format: xkeysib-...
BREVO_API_KEY=

# Resend API key — only needed when EMAIL_PROVIDER or EMAIL_FALLBACK_PROVIDER is "resend".
# Without a domain verified at resend.com/domains, Resend delivers only to the
# account owner's own address. Free tier: 100 emails/day.
# Format: re_...
RESEND_API_KEY=

# Resend webhook secret — verifies that delivery status callbacks come from Resend.
# In the Resend dashboard: Webhooks → Add Endpoint →
#   URL: https://<your-worker>.workers.dev/api/email/resend-callback
#   Events: email.delivered, email.bounced, email.complained
#   → copy the Signing Secret shown after creation.
# Leave blank during local dev if you don't need delivery tracking.
# Format: whsec_...
RESEND_WEBHOOK_SECRET=
